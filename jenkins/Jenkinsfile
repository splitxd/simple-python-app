pipeline {
    // Агент (agent) указывает, где будет выполняться pipeline.
    // 'any' - означает запуск на любом доступном агенте.
    agent {
        docker { image 'dh-mirror.gitverse.ru/python:3.13.7-alpine3.22' }
        }

    // Блок stages содержит последовательность этапов выполнения.
    stages {
        // Stage 1 - первый этап pipeline
        stage('Build') {
            // Блок steps содержит конкретные действия/команды
            steps {
            // открываем виртуальное окружение для Python, это нужно чтобы был доступ сохранить зависимости из файла requirements.txt
                sh '''
                python -m venv venv
                . venv/bin/activate 
                pip install -r requirements.txt
                '''
            }
        }
    }
}